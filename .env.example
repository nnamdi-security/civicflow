# Copy to .env and adjust. Never commit .env.
# Local Docker Postgres+PostGIS (see docker-compose.yml). The password here is the
# local-only dev default, not a real secret.
DATABASE_URL=postgres://civicflow:civicflow_dev_only@localhost:5433/civicflow
TEST_DATABASE_URL=postgres://civicflow:civicflow_dev_only@localhost:5433/civicflow_test

# Auth.js session/token signing. Generate your own: openssl rand -base64 32
AUTH_SECRET=

# The public address of the site, used in every link in emails and texts. Required in production
# (must be https). In development it defaults to http://localhost:3000.
# AUTH_URL=https://your-domain.example

# Email (Resend). Leave both empty in local dev: sign-in emails are written to
# .dev-outbox/ instead; read the latest with `pnpm dev:last-email`.
# Both are required in production.
RESEND_API_KEY=
EMAIL_FROM=

# Photos (Cloudinary). Leave all three empty in local dev: photos are stored in .dev-media/
# (gitignored) by a dev-only store that refuses to run in production. Set all three in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS (optional). Set both or neither. Without them, development writes SMS to .dev-outbox/ and production sends none.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=dnd

# Public pages. The overdue board and public deadlines stay off until real SLA values are agreed (ADR 0013).
# PUBLIC_OVERDUE_BOARD=false

# Copy to .env and adjust. Never commit .env.
# Local Docker Postgres+PostGIS (see docker-compose.yml). The password here is the
# local-only dev default, not a real secret.
DATABASE_URL=postgres://civicflow:civicflow_dev_only@localhost:5433/civicflow
TEST_DATABASE_URL=postgres://civicflow:civicflow_dev_only@localhost:5433/civicflow_test

# Auth.js session/token signing. Generate your own: openssl rand -base64 32
AUTH_SECRET=

# Email (Resend). Leave both empty in local dev: sign-in emails are written to
# .dev-outbox/ instead; read the latest with `pnpm dev:last-email`.
# Both are required in production.
RESEND_API_KEY=
EMAIL_FROM=

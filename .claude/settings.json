{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm db:generate:*)"
    ],
    "ask": [
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
  
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(pnpm drizzle-kit drop:*)",
      "Bash(pnpm drizzle-kit push:*)"
    ]
  }
}
